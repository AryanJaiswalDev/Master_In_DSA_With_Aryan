class Solution {
    Node lca(Node root, int p, int q) {
        if(root==null) return null;
        if(root.data==p||root.data==q)return root;

        boolean ploca=exist(root.left,p);
        boolean qloca=exist(root.right,q);

        if(ploca && !qloca) return lca(root.left,p,q);
        else if(!ploca && qloca) return lca(root.right,p,q);
        else return root;
    }
    
    public boolean exist(Node root,int data){
        if(root==null) return false;
        if(data==root.data) return true;
        
        return (exist(root.left,data)|| exist(root.right,data));
    
    }
  }
