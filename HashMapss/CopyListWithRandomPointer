class Solution {
    public Node deepcopy(Node head1){
        Node temp1=head1;
        Node head2=new Node(-1);
        Node temp2=head2;
        while(temp1!=null){
            Node t=new Node(temp1.val);
            temp2.next=t;
            temp2=t;
            temp1=temp1.next;
        }
        return head2.next;
    }

    public Node copyRandomList(Node head1) {
        Node b=deepcopy(head1);
        Node tempA=head1;
        Node tempB=b;
        HashMap<Node,Node> amap=new HashMap<>();
        HashMap<Node,Node> bmap=new HashMap<>();
        HashMap<Node,Node> map=new HashMap<>();
        while(tempA!=null){
            map.put(tempA,tempB);
            tempA=tempA.next;
            tempB=tempB.next;
        }
        map.put(null,null);

         tempA=head1;
        while(tempA!=null){
            (map.get(tempA)).random=map.get(tempA.random);
            tempA=tempA.next;
            
        }
        return b;
      
