class Solution {
    public int longestUniqueSubstr(String s) {
        if(s.length()==1)return 1;
        HashSet<Character> set=new HashSet<>();
        int i=0;
        int j=0;
        int length=0;
        int maxlength=0;
      
            while(j<s.length()){
                if(!set.contains(s.charAt(j))){
                    set.add(s.charAt(j));
                     maxlength=Math.max(maxlength,j-i+1);
                     j++;
                    
                
            }else{
                set.remove(s.charAt(i));
                i++;
               
            }
            }
            return maxlength;
    }
}
