class Solution {
    public int canCompleteCircuit(int[] gas, int[] cost) {
       
        int fuel=0;
        int total=0;
        int start=0;
        for(int i=0;i<gas.length;i++){
            fuel+=gas[i]-cost[i];
            total+=gas[i]-cost[i];
            if(fuel<0){
                fuel=0;
                start=i+1;
            }
        }
        if(total>=0){
            return start;
        }else{
            return -1;
        }

    }
}
