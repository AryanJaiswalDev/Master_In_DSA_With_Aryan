class Solution {
    public int findKthLargest(int[] nums, int k) {

        //*by min heap*
        PriorityQueue<Integer> pq=new PriorityQueue<>();
        for(int ele:nums){
            pq.add(ele);
        }
        for(int i=0;i<nums.length-k;i++){
            pq.poll();
        }
        return pq.poll();



