class Solution {

    public static void swap(int[] nums, int i, int j) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }

    public void nextPermutation(int[] nums) {

        int pvt = -1;

        // Step 1: Find pivot
        for(int i = nums.length - 1; i > 0; i--) {

            if(nums[i - 1] < nums[i]) {
                pvt = i - 1;
                break;
            }
        }

        // No pivot -> completely decreasing
        if(pvt == -1) {

            int p = 0;
            int q = nums.length - 1;

            while(p < q) {
                swap(nums, p, q);
                p++;
                q--;
            }

            return;
        }

        // Step 2: Find element greater than pivot
        for(int i = nums.length - 1; i > pvt; i--) {

            if(nums[i] > nums[pvt]) {
                swap(nums, i, pvt);
                break;
            }
        }

        // Step 3: Reverse the right part
        int k = pvt + 1;
        int m = nums.length - 1;

        while(k < m) {
            swap(nums, k, m);
            k++;
            m--;
        }
    }
}
