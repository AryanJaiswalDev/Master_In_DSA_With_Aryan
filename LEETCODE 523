class Solution {
    public boolean checkSubarraySum(int[] nums, int k) {
        HashMap<Integer,Integer> map=new HashMap<>();
        map.put(0,-1);
        int sum=0;
        int length=0;
        for(int i=0;i<nums.length;i++){
            sum+=nums[i];
            int rem=((sum-k)+k)%k;
            if(!map.containsKey(rem)){
                map.put(rem,i);
            }else{
                length=i-map.get(rem);
                if(length>=2)return true;

            }
        }
        return false;
    }
}
